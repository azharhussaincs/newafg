[Unit]
Description=Civil Registry Enterprise Data Platform (FastAPI & Vite React)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu22
WorkingDirectory=/home/ubuntu22/Desktop/newafg
ExecStart=/home/ubuntu22/Desktop/newafg/supervisor.sh
ExecStop=/home/ubuntu22/Desktop/newafg/stop.sh
Restart=always
RestartSec=5s
Environment=PATH=/home/ubuntu22/snap/antigravity-cli/common/local/bin:/home/ubuntu22/Desktop/newafg/.venv/bin:/home/ubuntu22/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=append:/home/ubuntu22/Desktop/newafg/supervisor.log
StandardError=append:/home/ubuntu22/Desktop/newafg/supervisor.log

[Install]
WantedBy=multi-user.target
